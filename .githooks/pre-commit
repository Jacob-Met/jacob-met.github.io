#!/bin/sh
# Pre-commit guard: docs/ is generated output, never hand-edit it.
#
# Rebuilds the site into a temp dir and fails the commit when the working
# tree's docs/ differs from a fresh build. This blocks the exact failure
# class behind jacob-met.github.io#11 (editing source/content.json without
# regenerating docs/, which the Verify public site workflow then rejects).
#
# Enable once per clone:
#   git config core.hooksPath .githooks
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRATCH="$(mktemp -d 2>/dev/null)" || {
    echo "pre-commit: cannot create temp dir (check disk space / TMPDIR)" >&2
    exit 1
}
trap 'rm -rf "$SCRATCH"' EXIT INT TERM

if ! python3 "$REPO_ROOT/source/build.py" --out "$SCRATCH/checked-site" \
        >"$SCRATCH/build.log" 2>&1; then
    echo "pre-commit: site build failed; fix the build errors before committing" >&2
    tail -5 "$SCRATCH/build.log" >&2 || true
    exit 1
fi

if ! diff -qr "$REPO_ROOT/docs" "$SCRATCH/checked-site" >/dev/null 2>&1; then
    echo "pre-commit: docs/ differs from a fresh build of source/" >&2
    echo "pre-commit: after editing source/content.json, run:" >&2
    echo "pre-commit:   python3 source/build.py --out docs && git add docs" >&2
    echo "pre-commit: then commit the source change and regenerated docs/ together" >&2
    exit 1
fi

exit 0
