#!/bin/sh
# Pre-commit guard: docs/ is generated output, never hand-edit it.
#
# Validates the STAGED tree (what this commit will record), not the working
# tree: materializes the index into a temp dir, rebuilds the site from the
# staged source/, and fails the commit when the staged docs/ differs from a
# fresh build. Checking the working tree is not enough -- staging
# source/content.json while leaving the regenerated docs/ unstaged would
# otherwise commit the exact source/docs drift this hook exists to block
# (jacob-met.github.io#11, caught in review of this hook).
#
# Enable once per clone:
#   git config core.hooksPath .githooks
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Fast path: a commit that stages nothing under source/ or docs/ cannot
# introduce site drift.
if ! git diff --cached --name-only | grep -q -e '^source/' -e '^docs/'; then
    exit 0
fi

SCRATCH="$(mktemp -d 2>/dev/null)" || {
    echo "pre-commit: cannot create temp dir (check disk space / TMPDIR)" >&2
    exit 1
}
trap 'rm -rf "$SCRATCH"' EXIT INT TERM

STAGED="$SCRATCH/staged"
mkdir -p "$STAGED"
# Materialize exactly what is staged (the index), never the working tree.
if ! git checkout-index -a --prefix="$STAGED/"; then
    echo "pre-commit: cannot materialize the staged tree; refusing to guess" >&2
    exit 1
fi

if [ ! -d "$STAGED/docs" ]; then
    echo "pre-commit: staged tree has no docs/; regenerate and stage it with the source change" >&2
    echo "pre-commit:   python3 source/build.py --out docs && git add docs" >&2
    exit 1
fi

if ! python3 "$STAGED/source/build.py" --out "$STAGED/fresh-docs" \
        >"$SCRATCH/build.log" 2>&1; then
    echo "pre-commit: site build failed on the staged source; fix the build errors before committing" >&2
    tail -5 "$SCRATCH/build.log" >&2 || true
    exit 1
fi

if ! diff -qr "$STAGED/docs" "$STAGED/fresh-docs" >/dev/null 2>&1; then
    echo "pre-commit: staged docs/ differs from a fresh build of the staged source/" >&2
    echo "pre-commit: after editing source/content.json, run:" >&2
    echo "pre-commit:   python3 source/build.py --out docs && git add docs" >&2
    echo "pre-commit: then commit the source change and regenerated docs/ together" >&2
    exit 1
fi

exit 0
