#!/bin/sh
# Pre-commit guard: generated pages must match the maintained staged inputs.
#
# Validates the STAGED tree (what the commit will actually contain), not the
# working tree: it materializes the index into a temp dir with
# `git checkout-index`, composes the staged source/ and tools/site/ generators
# with declared static inputs, and fails when staged docs/ differs from the
# complete fresh output. This blocks the
# exact failure class behind jacob-met.github.io#11 (committing a source
# change without the regenerated docs/, which the Verify public site
# workflow then rejects).
#
# Validating the working tree instead would let staged-but-unrebuilt docs/
# slip through: e.g. edit source/content.json, rebuild docs/, then stage only
# source/ — the working tree looks consistent while the commit reintroduces
# drift. (Review finding on PR #14; regression-tested in
# source/test_site.py::PrecommitHookTests.)
#
# Enable once per clone:
#   git config core.hooksPath .githooks
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRATCH="$(mktemp -d 2>/dev/null)" || {
    echo "pre-commit: cannot create temp dir (check disk space / TMPDIR)" >&2
    exit 1
}
trap 'rm -rf "$SCRATCH"' EXIT INT TERM

# Fast path: no staged build input, output or guard change.
if git -C "$REPO_ROOT" diff --cached --quiet -- source docs tools/site .githooks/pre-commit; then
    exit 0
fi

# Materialize the staged tree exactly as the commit will contain it.
# This never touches the working tree (no stash), so unstaged edits are
# irrelevant to the check, and a checkout failure blocks the commit.
mkdir -p "$SCRATCH/staged"
if ! git -C "$REPO_ROOT" checkout-index -a --prefix="$SCRATCH/staged/"; then
    echo "pre-commit: could not materialize the staged tree; refusing to commit" >&2
    exit 1
fi

# This guard proves staged source/docs correspondence, not release eligibility.
# Review mode is read ONLY from the materialized index. The default production
# builder/checker and deployment verifier continue to reject local-preview.
BUILD_MODE="$(python3 - "$SCRATCH/staged/source/lobby-manifest.json" <<'MODE'
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
if p.is_symlink():
    raise SystemExit('staged route manifest cannot be a symlink')
print(json.loads(p.read_text(encoding='utf-8')).get('visibility', '') if p.exists() else '')
MODE
)" || {
    echo "pre-commit: cannot read staged route mode; refusing to commit" >&2
    exit 1
}
set --
if [ "$BUILD_MODE" = "local-preview" ]; then
    set -- --preview
fi

# The staged composer owns application preservation and declared static inputs.
# It builds into a fresh sibling directory, then runs the maintained Node stages.
# Explicit paths keep the worktree's tooling and inventory out of this check.
if ! python3 "$SCRATCH/staged/tools/site/rebuild.py" \
        --source-tree "$SCRATCH/staged" \
        --inputs "$SCRATCH/staged/tools/site/current-inputs.json" \
        --out "$SCRATCH/checked-site" "$@" \
        >"$SCRATCH/build.log" 2>&1; then
    echo "pre-commit: site build failed on the staged inputs; fix the build errors before committing" >&2
    tail -5 "$SCRATCH/build.log" >&2 || true
    exit 1
fi

if ! diff -qr "$SCRATCH/staged/docs" "$SCRATCH/checked-site" >/dev/null 2>&1; then
    echo "pre-commit: staged docs/ differs from a fresh build of the staged inputs" >&2
    if [ "$BUILD_MODE" = "local-preview" ]; then
        echo "pre-commit: rebuild with 'python3 tools/site/rebuild.py --preview --out /path/to/new-output'" >&2
    else
        echo "pre-commit: rebuild with 'python3 tools/site/rebuild.py --out /path/to/new-output'" >&2
    fi
    echo "pre-commit: use a new output directory outside this checkout; review and stage the matching inputs and docs/ together" >&2
    exit 1
fi

if [ "$BUILD_MODE" = "local-preview" ]; then
    echo "pre-commit: staged local-preview source/docs match; review only, not production eligibility" >&2
fi

exit 0

